      "workflows": {
        "anima_only": {
          "fields": {
            "ANIMA_HAND_DETAILER": {
              "steps": 16,
              "cfg": 5,
              "sampler_name": "dpmpp_2m_sde",
              "scheduler": "linear_quadratic",
              "denoise": 0.15
            },
            "ANIMA_HIRESFIX": {
              "steps": 12,
              "cfg": 5,
              "sampler_name": "dpmpp_2m_sde",
              "scheduler": "linear_quadratic",
