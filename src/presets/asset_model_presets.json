            "ANIMA_EYE_DETAILER": {
              "steps": 12,
              "cfg": 5,
              "sampler_name": "dpmpp_2m_sde",
              "scheduler": "linear_quadratic",
              "denoise": 0.25
            },
            "ANIMA_FACE_DETAILER": {
              "steps": 12,
              "cfg": 5,
              "sampler_name": "dpmpp_2m_sde_gpu",
              "scheduler": "linear_quadratic",
              "denoise": 0.25
            },
            "ANIMA_FIRST_SAMPLER": {
              "steps": 25,
              "cfg": 4,
              "sampler_name": "dpmpp_sde_gpu",
              "scheduler": "linear_quadratic",
              "sampler_mode": "SpectrumKSamplerModGuidance",
              "spd_scale": 0.5,
              "spd_sigma": 0.7,
              "sage_attention": true
            },
            "ANIMA_DIFFUSION_MODEL": "Anima-2.9B-preview-v1.safetensors",
            "workflow.clip": "qwen_3_06b_base.safetensors",
            "workflow.clip_device": "gpu",
            "workflow.sequential_offload": false,
            "STYLE_LORA_DATA": {
              "list": [
